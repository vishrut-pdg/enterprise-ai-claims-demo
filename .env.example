APP_ENV=local

DATABASE_URL=postgresql+psycopg://claims:claims@localhost:5432/claims_week4
REDIS_URL=redis://localhost:6379/0

LLM_PROVIDER=ollama
LLM_MODEL=gemma4:e4b-it-q4_K_M

OLLAMA_BASE_URL=http://localhost:11434

GCP_PROJECT_ID=
GCP_LOCATION=

BTP_AI_DEPLOYMENT_ID=

OTEL_SERVICE_NAME=enterprise-ai-claims
LOG_LEVEL=INFO

# OAuth/inference settings for SAP AI Core Azure OpenAI deployments
BTP_AI_BASE_URL=
BTP_TOKEN_URL=
BTP_CLIENT_ID=
BTP_CLIENT_SECRET=
BTP_RESOURCE_GROUP=default
BTP_API_VERSION=2024-10-21
LLM_TIMEOUT=60
# Optional OTLP HTTP collector; spans are available without an exporter.
OTEL_EXPORTER_OTLP_ENDPOINT=
CORS_ORIGINS=["http://localhost:5173"]

# API and worker must use the same queue; defaults to claims.
ARQ_QUEUE_NAME=claims-week4

# Policy RAG: index the README before enabling. Vertex embeddings use ADC.
RAG_ENABLED=false
EMBEDDING_PROVIDER=vertex
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_LOCATION=us-central1

# Week 4: automatic discovery, AI investigation and accept/reject decisions
DECISION_MODE=autonomous
AUTONOMOUS_RETRY_SECONDS=300


# Optional USD per million token/character rates; replaces defaults for an exact provider:model.
# AI_COST_RATES={"btp:deployment-model":{"input":1.0,"output":3.0}}
AI_COST_RATES={}
